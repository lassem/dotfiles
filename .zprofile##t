# ~/.zprofile — sourced for login shells
# Managed by yadm. Edit ~/.zprofile##t, then run `yadm alt` to regenerate.

{% if yadm.os == "Darwin" %}
eval "$(/opt/homebrew/bin/brew shellenv)"

# Homebrew's shellenv can put its Rust toolchain ahead of rustup.
if rustup_cargo="$(rustup which cargo 2>/dev/null)"; then
  export PATH="$(dirname "$rustup_cargo"):$PATH"
fi
unset rustup_cargo

if [[ -d /opt/homebrew/opt/llvm/bin ]]; then
  export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
{% endif %}
